# WordArchitect environment configuration
# Copy to `.env.local` and fill in real values. Never commit your real .env.

# --- AI provider ---------------------------------------------------------
# Which provider backs the AI features. Currently: "anthropic" (default).
AI_PROVIDER=anthropic

# Optional model override for the selected provider.
# Defaults to claude-opus-5 for the Anthropic provider.
# AI_MODEL=claude-opus-5

# Anthropic / Claude API key — required for AI features.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Database (for when the data layer lands) ----------------------------
# SQLite for local dev; swap the URL for Postgres in production.
# DATABASE_URL="file:./dev.db"

# --- WordArchitect Backend (Content Management API) -----------------------
# Base URL for the real backend (Books/Codex/World Categories/Notes/
# Manuscript). Public — read client-side, hence NEXT_PUBLIC_. Defaults to
# the hosted instance if unset; override for local backend development.
# Render's free tier spins down on inactivity — the first request after a
# quiet period can take several seconds (cold start), not a bug.
NEXT_PUBLIC_API_BASE_URL=https://wordarchitect-backend.onrender.com
